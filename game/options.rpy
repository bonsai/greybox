# GREYBOX Ren'Py project settings.
# GUI defaults live in gui.rpy (generated by the Ren'Py launcher).

define config.name = "GREYBOX"
define config.version = "0.1.0"
define build.name = "greybox"

define gui.show_name = True
define gui.about = _p("""
GREYBOX — Human × AI
任せる、検証する、決断する。
""")

define config.save_directory = "greybox-1"
define config.window = "auto"
define config.default_fullscreen = False

# --- Packaging ---------------------------------------------------------------
# Only the Ren'Py project ships. Canonical story data, dev tooling and CI
# configuration stay in the repository; game/story/ is what the runtime loads.
init python:
    build.classify("story/**", None)
    build.classify("tools/**", None)
    build.classify("bin/**", None)
    build.classify("docs/**", None)
    build.classify(".github/**", None)
    build.classify(".opencode/**", None)
    build.classify("dist/**", None)
    build.classify("log/**", None)
    build.classify("game/cache/**", None)
    build.classify("game/saves/**", None)
    build.classify("README.md", None)
    build.classify("requirements-dev.txt", None)
    build.classify("**~", None)
    build.classify("**.bak", None)
    build.classify("**/.#**", None)
    build.classify("**/#**", None)
    build.classify("**/thumbs.db", None)
