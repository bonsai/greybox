{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bonsai.github.io/greybox/schema/story.schema.json",
  "title": "GREYBOX Portable Story",
  "type": "object",
  "required": [
    "schema_version",
    "story_id",
    "title",
    "language",
    "start_scene",
    "characters",
    "initial_state",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "story_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "start_scene": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/dialogue"
          },
          {
            "$ref": "#/$defs/choice"
          },
          {
            "$ref": "#/$defs/event"
          },
          {
            "$ref": "#/$defs/ending"
          }
        ]
      }
    }
  },
  "$defs": {
    "effects": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "integer",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "choiceItem": {
      "type": "object",
      "required": [
        "id",
        "text",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "required": [
        "id",
        "type",
        "speaker",
        "text",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "dialogue"
        },
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text",
        "choices"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "choice"
        },
        "text": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/choiceItem"
          }
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "type",
        "event",
        "next"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ending": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "text",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "const": "ending"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "partial",
            "failure"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
